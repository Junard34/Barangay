# =============================================================================
# FRONTEND CONFIGURATION (Add to Vercel Environment Variables)
# =============================================================================
VITE_API_URL=https://barangay-saray-backend.onrender.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# =============================================================================
# BACKEND API CONFIGURATION (Add to Render: barangay-saray-backend)
# =============================================================================
PORT=10000
NODE_ENV=production
FRONTEND_URL=https://thesiscapstone-main.vercel.app

# Authentication Secrets (Generate 64+ random characters)
JWT_SECRET=replace_with_a_strong_random_secret
SESSION_SECRET=replace_with_a_strong_random_secret

# Supabase Cloud Integration (Server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# SQLite Database Path (Optional / Local development fallback)
DB_PATH=./database/barangay.db

# Python Machine Learning Microservice URL
ML_SERVICE_URL=https://barangay-saray-ml.onrender.com

# PhilSMS Gateway Integration
PHILSMS_ENABLED=false
PHILSMS_API_TOKEN=your_philsms_api_token
PHILSMS_SENDER_ID=your_approved_sender_id
PHILSMS_API_URL=https://dashboard.philsms.com/api/v3/sms/send

# =============================================================================
# PYTHON AI SERVICE (Add to Render: barangay-saray-ml)
# =============================================================================
PYTHON_VERSION=3.11.9
